#!/bin/bash
# Dedicated authorized_keys forced command. Root-owned, run as ubuntu.
set -euo pipefail
if [[ ${SSH_ORIGINAL_COMMAND:-} =~ ^/usr/local/libexec/student-planner-backend-deploy\ ([0-9a-f]{40})$ ]]; then
    exec /usr/local/libexec/student-planner-backend-deploy "${BASH_REMATCH[1]}"
fi
printf '%s\n' 'Backend deployment command refused.' >&2
exit 1
